# Local only. Compose defaults are deliberately synthetic. Never put live secrets here.
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/cabaccess
DATABASE_USER=cab_app
DATABASE_PASSWORD=local-app-only
MIGRATION_USER=cab_owner
MIGRATION_PASSWORD=local-owner-only
OIDC_ISSUER=http://localhost:8180/realms/cab-access
OIDC_JWKS=http://localhost:8180/realms/cab-access/protocol/openid-connect/certs
# For non-local: PAYMENT_PROVIDER=razorpay and supply per-merchant secret prefix keys:
# PILOT_KEY_ID=provided-by-secret-store
# PILOT_KEY_SECRET=provided-by-secret-store
# PILOT_WEBHOOK_SECRET=provided-by-secret-store
# CAB_CONTACT_ENCRYPTION_KEY=base64-encoded-32-byte-key-from-secret-store
# NOTIFICATION_URL=https://approved-gateway.example.invalid/deliver
# NOTIFICATION_TOKEN=provided-by-secret-store
# GATE_URL=https://approved-gateway.example.invalid/commands
# GATE_TOKEN=provided-by-secret-store
